{
  "name": "Required CI and protected master",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["merge", "squash", "rebase"],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {"context": "windows-tests", "integration_id": 15368},
          {"context": "macos-tests", "integration_id": 15368},
          {"context": "dependency-audit", "integration_id": 15368},
          {"context": "dependency-review", "integration_id": 15368},
          {"context": "codeql (python)", "integration_id": 15368},
          {"context": "codeql (actions)", "integration_id": 15368},
          {"context": "CodeQL", "integration_id": 57789},
          {"context": "runtime-integration", "integration_id": 15368},
          {"context": "contribution-evidence", "integration_id": 15368}
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ]
}
